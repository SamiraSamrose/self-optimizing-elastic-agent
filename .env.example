ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

MONITORING_CLUSTER_URL=http://localhost:9200
MONITORING_API_KEY=

SLOWLOG_INDEX_PATTERN=.ds-elasticsearch.slowlog-*
NODE_METRICS_INDEX_PATTERN=metrics-elasticsearch.node-*
INDEX_METADATA_INDEX=index-metadata

REASONING_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

DOCS_VECTOR_INDEX=elastic-docs-vectors
EMBEDDING_MODEL=all-MiniLM-L6-v2

LOOP_INTERVAL_SECONDS=3600
TOP_SLOW_QUERIES_LIMIT=5
SLOW_QUERY_MIN_COUNT=100

APPROVAL_WEBHOOK_URL=
APPROVAL_TIMEOUT_SECONDS=300

CLOUD_COST_PER_NODE_MONTHLY=200.0
CLOUD_PROVIDER=aws
BILLING_API_KEY=

EPHEMERAL_CLUSTER_URL=
SIMULATION_ENABLED=false
BENCHMARK_ITERATIONS=10
